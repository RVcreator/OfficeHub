
# OfficeHub local development configuration
# Copy this file to .env.local
# Never commit actual credentials.

# Supabase public frontend configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Microsoft 365 and Graph credentials must remain
# in Supabase Edge Function secrets, not VITE_ variables.

# Production hosting: cPanel
# Frontend deployment is managed by GitHub Actions.
